# Public URL, no trailing slash. Used for auth callbacks and the PWA manifest.
SITE_URL=http://localhost:3000

# SQLite file. Mount this path as a volume in production.
DATABASE_PATH=data/chordy.db

# Set true to stop new accounts: only accounts that already exist can sign in. Unset or false
# leaves sign-up open to anyone who can reach the sign-in form, so set true once your own account
# exists, unless the server sits behind a VPN or an access gate.
DISABLE_SIGNUP=false

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# SMTP delivery. Without a host, sign-in emails are printed to the terminal instead.
# Leave USER and PASSWORD empty for a relay that authenticates by IP.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# From address. Must be one your SMTP server is allowed to send as.
EMAIL_FROM=chordy@example.com
