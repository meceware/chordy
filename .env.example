# Public URL, no trailing slash. Used for auth callbacks and the PWA manifest.
SITE_URL=http://localhost:3000

# SQLite file. Mount this path as a volume in production.
DATABASE_PATH=data/chords.db

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# SMTP delivery. Without a host, sign-in emails are printed to the terminal instead.
# Leave USER and PASSWORD empty for a relay that authenticates by IP.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# From address. Must be one your SMTP server is allowed to send as.
EMAIL_FROM="Chordy <chordy@example.com>"
